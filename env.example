# ibkr_mcp environment configuration
# Copy to .env and fill in your values

# IB Gateway connection
IB_HOST=127.0.0.1
IB_PORT=4001              # 4001 = IB Gateway, 7497 = TWS
IB_CLIENT_ID=10           # Must be unique per connection. Don't use 0.
IB_TIMEOUT=10             # Connection timeout in seconds
IB_READONLY=true          # Default true (connection cannot place orders). Set false
                          # to enable whatIfOrder-based tools (what-if margin sim,
                          # stress preflight, cushion trim probe) — IB rejects
                          # whatIf requests on read-only API connections.
IB_MARKET_DATA_TYPE=4     # 1=live 2=frozen 3=delayed 4=delayed-frozen (default).
                          # delayed-frozen serves live data when a real-time
                          # subscription exists, else falls back gracefully
                          # instead of returning "unavailable".

# Account settings
PRIMARY_ACCOUNT=          # Your main account ID (leave blank to auto-detect)

# Secondary gateway — dual-account mode (optional)
# Set IB_PORT_2 to a second Gateway's port to enable. Leave 0 to disable.
IB_PORT_2=0               # e.g. 4002 for a second Gateway instance
IB_CLIENT_ID_2=20         # Must be unique, different from IB_CLIENT_ID
SECONDARY_ACCOUNT=        # Secondary account ID (leave blank to auto-detect)

# HTTP server (server_http.py only)
MCP_HTTP_PORT=8000        # Port to listen on — must match Tailscale Funnel target
MCP_HTTP_HOST=0.0.0.0     # Bind address: 0.0.0.0 required for Tailscale Funnel
MCP_HTTP_TOKEN=           # THE auth switch for HTTP transport. Unset = auth OFF
                          # (unauthenticated surface). Set = all HTTP clients must
                          # send "Authorization: Bearer <token>". See
                          # AUTH_ACTIVATION.md before setting this.
IBKR_MCP_ALLOWED_HOSTS=   # Extra exact MCP Host values for private proxies, comma-separated.
                          # Loopback, host.docker.internal, verified Tailscale Serve, and
                          # the OAuth issuer are automatic; host:* means one host/any port.
IBKR_MCP_ALLOWED_ORIGINS= # Extra exact browser origins allowed to call MCP.
IBKR_HTTP_ALLOWED_HOSTS=  # Extra Host values for tokenless /api access (e.g. tailnet Serve).

# Dashboard (dashboard.py) — optional, only needed for web frontend
GEMINI_API_KEY=           # Gemini API key for /api/query passthrough
MCP_URL=                  # MCP server URL for Claude to connect back to (e.g. http://localhost:8000/mcp)
DASHBOARD_DIST=           # Explicit path to a Vite dist containing index.html. Blank forces
                          # API-only; if unset, the legacy sibling dist default is used only
                          # when it contains index.html. The service repo is never mounted.
YAHOO_CACHE_TTL=30        # Seconds to cache Yahoo Finance prices

# Persistence — NLV history database
IBKR_DB_PATH=             # SQLite file path. Default: ~/.ibkr-terminal/history.db
IBKR_CACHE_MAX_AGE=3600   # Seconds before a cached tool response (served when IB
                          # Gateway is offline) is discarded. Default 3600 (1hr).

# Background snapshot recorder (server_http.py only)
IBKR_SNAPSHOT_INTERVAL_MIN=30   # Minutes between automatic NLV/margin history
                                # snapshots (feeds drawdown peak + margin_history).
                                # 0 disables; the drawdown tool still records.
IBKR_WHATIF_TTL=120             # Seconds to memoize ambient whatIfOrder margin
                                # probes (briefing/efficiency/headroom). 0 = every
                                # probe hits IB's margin engine live. The explicit
                                # what-if tool is never memoized.
